-- 4. SELECT AND DISTINCT
SELECT * FROM dbo.Persons;
SELECT * FROM dbo.AccessLogs;
SELECT * FROM dbo.Evidence;
SELECT * FROM dbo.Witnesses;

SELECT FullName, Role
FROM dbo.Persons;

