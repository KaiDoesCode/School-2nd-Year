-- 33. COMPLETE INVESTIGATION QUERY
SELECT
    a.LogID,
    p.PersonID,
    p.FullName,
    p.Role,
    a.LabName,
    a.AccessTime,
    a.AccessStatus,
    e.EvidenceID,
    e.EvidenceType,
    e.Description AS EvidenceDescription,
    w.WitnessID,
    w.WitnessName,
    w.Statement AS WitnessStatement
FROM dbo.AccessLogs AS a
LEFT JOIN dbo.Persons AS p
    ON a.PersonID = p.PersonID
LEFT JOIN dbo.Evidence AS e
    ON a.LogID = e.LogID
LEFT JOIN dbo.Witnesses AS w
    ON a.LogID = w.LogID
WHERE a.LabName = 'Laboratory 3B'
  AND a.AccessTime >= '2026-10-12T21:10:00'
  AND a.AccessTime <= '2026-10-12T21:25:00'
ORDER BY a.AccessTime ASC;

