-- 5. WHERE AND COMPARISON OPERATORS
SELECT * FROM dbo.Persons WHERE Role = 'Student';
SELECT * FROM dbo.Persons WHERE Role <> 'Student';
SELECT * FROM dbo.Persons WHERE PersonID > 2;
SELECT * FROM dbo.Persons WHERE PersonID < 3;
SELECT * FROM dbo.Persons WHERE PersonID >= 2;
SELECT * FROM dbo.Persons WHERE PersonID <= 3;

-- 6. AND, OR, NOT
SELECT * FROM dbo.AccessLogs
WHERE LabName = 'Laboratory 3B'
  AND AccessStatus = 'Denied';

SELECT * FROM dbo.AccessLogs
WHERE AccessStatus = 'Denied'
   OR AccessStatus = 'Allowed';

SELECT * FROM dbo.Persons
WHERE NOT Role = 'Student';

-- 7. BETWEEN, IN, LIKE, NULL
SELECT * FROM dbo.Persons
WHERE PersonID BETWEEN 1 AND 3;

SELECT * FROM dbo.Persons
WHERE Role IN ('Student', 'Laboratory Assistant');

SELECT * FROM dbo.Persons
WHERE FullName LIKE 'A%';

SELECT * FROM dbo.Persons
WHERE FullName LIKE '%s';

SELECT * FROM dbo.Persons
WHERE FullName LIKE '%an%';

SELECT * FROM dbo.Evidence
WHERE Description IS NULL;

SELECT * FROM dbo.Evidence
WHERE Description IS NOT NULL;

-- 8. ORDER BY AND TOP
SELECT * FROM dbo.AccessLogs
ORDER BY AccessTime ASC;

SELECT * FROM dbo.AccessLogs
ORDER BY AccessTime DESC;

SELECT TOP 5 *
FROM dbo.AccessLogs
ORDER BY AccessTime DESC;

-- 9. INNER JOIN
SELECT p.FullName, a.LogID, a.LabName,
       a.AccessTime, a.AccessStatus
FROM dbo.Persons AS p
INNER JOIN dbo.AccessLogs AS a
    ON p.PersonID = a.PersonID;

-- 10. LEFT JOIN
SELECT p.FullName, a.LogID, a.LabName
FROM dbo.Persons AS p
LEFT JOIN dbo.AccessLogs AS a
    ON p.PersonID = a.PersonID;

-- 11. RIGHT JOIN
SELECT p.FullName, a.LogID, a.LabName
FROM dbo.Persons AS p
RIGHT JOIN dbo.AccessLogs AS a
    ON p.PersonID = a.PersonID;

-- 12. FULL OUTER JOIN
SELECT p.PersonID, p.FullName, a.LogID
FROM dbo.Persons AS p
FULL OUTER JOIN dbo.AccessLogs AS a
    ON p.PersonID = a.PersonID;

-- 13. CROSS JOIN
SELECT p.FullName, a.LabName
FROM dbo.Persons AS p
CROSS JOIN dbo.AccessLogs AS a;

-- 14. SELF JOIN
SELECT
    p1.FullName AS Person1,
    p2.FullName AS Person2,
    p1.Role
FROM dbo.Persons AS p1
INNER JOIN dbo.Persons AS p2
    ON p1.Role = p2.Role
WHERE p1.PersonID < p2.PersonID;

-- 15. JOIN ALL FOUR TABLES
SELECT
    p.FullName,
    p.Role,
    a.LogID,
    a.LabName,
    a.AccessTime,
    a.AccessStatus,
    e.EvidenceType,
    e.Description AS EvidenceDescription,
    w.WitnessName,
    w.Statement AS WitnessStatement
FROM dbo.AccessLogs AS a
LEFT JOIN dbo.Persons AS p
    ON a.PersonID = p.PersonID
LEFT JOIN dbo.Evidence AS e
    ON a.LogID = e.LogID
LEFT JOIN dbo.Witnesses AS w
    ON a.LogID = w.LogID
ORDER BY a.AccessTime;

-- 16. AGGREGATE FUNCTIONS
SELECT COUNT(*) AS TotalLogs
FROM dbo.AccessLogs;

SELECT COUNT(*) AS DeniedAttempts
FROM dbo.AccessLogs
WHERE AccessStatus = 'Denied';

SELECT MIN(AccessTime) AS FirstAccess
FROM dbo.AccessLogs;

SELECT MAX(AccessTime) AS LastAccess
FROM dbo.AccessLogs;

SELECT
    SUM(PersonID) AS SumPersonIDs,
    AVG(CAST(PersonID AS DECIMAL(10,2))) AS AveragePersonID,
    MIN(PersonID) AS LowestPersonID,
    MAX(PersonID) AS HighestPersonID
FROM dbo.Persons;

-- 17. GROUP BY AND HAVING
SELECT LabName, COUNT(*) AS TotalLogs
FROM dbo.AccessLogs
GROUP BY LabName;

SELECT AccessStatus, COUNT(*) AS Total
FROM dbo.AccessLogs
GROUP BY AccessStatus;

SELECT PersonID, COUNT(*) AS TotalAttempts
FROM dbo.AccessLogs
GROUP BY PersonID
HAVING COUNT(*) > 1;

SELECT LabName, COUNT(*) AS TotalDenied
FROM dbo.AccessLogs
WHERE AccessStatus = 'Denied'
GROUP BY LabName
HAVING COUNT(*) >= 1;

-- 18. DATE AND TIME QUERIES
SELECT *
FROM dbo.AccessLogs
WHERE LabName = 'Laboratory 3B'
  AND AccessTime >= '2026-10-12T21:10:00'
  AND AccessTime <= '2026-10-12T21:25:00'
ORDER BY AccessTime;

SELECT *
FROM dbo.AccessLogs
WHERE AccessTime >= '2026-10-01'
  AND AccessTime < '2026-11-01';

SELECT
    LogID,
    CAST(AccessTime AS DATE) AS AccessDate,
    CAST(AccessTime AS TIME) AS AccessClockTime
FROM dbo.AccessLogs;

SELECT
    DATEPART(HOUR, AccessTime) AS AccessHour,
    COUNT(*) AS TotalEvents
FROM dbo.AccessLogs
GROUP BY DATEPART(HOUR, AccessTime)
ORDER BY AccessHour;

SELECT *
FROM dbo.AccessLogs
WHERE AccessTime >= DATEADD(HOUR, -24, SYSDATETIME())
  AND AccessTime <= SYSDATETIME();

-- 19. SUBQUERIES: IN, NOT IN, EXISTS, NOT EXISTS
SELECT *
FROM dbo.Persons
WHERE PersonID IN (
    SELECT PersonID
    FROM dbo.AccessLogs
);

SELECT *
FROM dbo.Persons
WHERE PersonID NOT IN (
    SELECT PersonID
    FROM dbo.AccessLogs
    WHERE PersonID IS NOT NULL
);

SELECT p.*
FROM dbo.Persons AS p
WHERE EXISTS (
    SELECT 1
    FROM dbo.AccessLogs AS a
    WHERE a.PersonID = p.PersonID
      AND a.AccessStatus = 'Denied'
);

SELECT p.*
FROM dbo.Persons AS p
WHERE NOT EXISTS (
    SELECT 1
    FROM dbo.AccessLogs AS a
    WHERE a.PersonID = p.PersonID
);

SELECT *
FROM dbo.AccessLogs
WHERE AccessTime = (
    SELECT MAX(AccessTime)
    FROM dbo.AccessLogs
);

-- 20. SUBQUERY WITH AVERAGE ATTEMPTS
SELECT PersonID, COUNT(*) AS TotalAttempts
FROM dbo.AccessLogs
GROUP BY PersonID
HAVING COUNT(*) > (
    SELECT AVG(CAST(AttemptCount AS DECIMAL(10,2)))
    FROM (
        SELECT COUNT(*) AS AttemptCount
        FROM dbo.AccessLogs
        GROUP BY PersonID
    ) AS PersonAttempts
);

-- 21. UNION AND UNION ALL
SELECT FullName AS Name
FROM dbo.Persons
WHERE Role = 'Student'
UNION
SELECT WitnessName AS Name
FROM dbo.Witnesses;

SELECT FullName AS Name
FROM dbo.Persons
UNION ALL
SELECT WitnessName AS Name
FROM dbo.Witnesses;

-- 22. CASE AND CONDITIONAL AGGREGATION
SELECT
    LogID,
    LabName,
    AccessStatus,
    CASE
        WHEN AccessStatus = 'Denied' THEN 'Review Required'
        WHEN AccessStatus = 'Allowed' THEN 'Access Granted'
        ELSE 'Unknown Status'
    END AS AccessResult
FROM dbo.AccessLogs;

SELECT
    COUNT(*) AS TotalEvents,
    SUM(CASE WHEN AccessStatus = 'Denied'
        THEN 1 ELSE 0 END) AS DeniedCount,
    SUM(CASE WHEN AccessStatus = 'Allowed'
        THEN 1 ELSE 0 END) AS AllowedCount
FROM dbo.AccessLogs;

-- 23. ISNULL, COALESCE, CONCAT
SELECT
    EvidenceID,
    ISNULL(Description, 'No description') AS EvidenceDescription
FROM dbo.Evidence;

SELECT
    COALESCE(Description, 'No description') AS EvidenceDescription
FROM dbo.Evidence;

SELECT CONCAT(FullName, ' - ', Role) AS PersonDetails
FROM dbo.Persons;

-- 24. COMMON TABLE EXPRESSIONS (CTEs)
;WITH DeniedLogs AS (
    SELECT *
    FROM dbo.AccessLogs
    WHERE AccessStatus = 'Denied'
)
SELECT * FROM DeniedLogs;

;WITH LabLogs AS (
    SELECT *
    FROM dbo.AccessLogs
    WHERE LabName = 'Laboratory 3B'
)
SELECT p.FullName, l.AccessTime, l.AccessStatus
FROM LabLogs AS l
INNER JOIN dbo.Persons AS p
    ON l.PersonID = p.PersonID;

-- 25. WINDOW FUNCTIONS
SELECT
    PersonID,
    LogID,
    AccessTime,
    ROW_NUMBER() OVER (
        PARTITION BY PersonID
        ORDER BY AccessTime
    ) AS EventNumber
FROM dbo.AccessLogs;

;WITH PersonCounts AS (
    SELECT PersonID, COUNT(*) AS TotalAttempts
    FROM dbo.AccessLogs
    GROUP BY PersonID
)
SELECT
    PersonID,
    TotalAttempts,
    RANK() OVER (
        ORDER BY TotalAttempts DESC
    ) AS AttemptRank,
    DENSE_RANK() OVER (
        ORDER BY TotalAttempts DESC
    ) AS DenseRank
FROM PersonCounts;

SELECT
    PersonID,
    AccessTime,
    LAG(AccessTime) OVER (
        PARTITION BY PersonID ORDER BY AccessTime
    ) AS PreviousAccess,
    LEAD(AccessTime) OVER (
        PARTITION BY PersonID ORDER BY AccessTime
    ) AS NextAccess
FROM dbo.AccessLogs;

-- 26. CREATE AND USE VIEW
CREATE OR ALTER VIEW dbo.AccessLogDetails
AS
SELECT
    a.LogID,
    p.FullName,
    a.LabName,
    a.AccessTime,
    a.AccessStatus
FROM dbo.AccessLogs AS a
INNER JOIN dbo.Persons AS p
    ON a.PersonID = p.PersonID;
GO

SELECT * FROM dbo.AccessLogDetails;
