-- 1. CREATE DATABASE
IF DB_ID('LabSecurity') IS NULL
    CREATE DATABASE LabSecurity;
GO

USE LabSecurity;
GO

-- 2. CREATE TABLES
IF OBJECT_ID('dbo.Persons', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.Persons (
        PersonID INT IDENTITY(1,1) PRIMARY KEY,
        FullName VARCHAR(100) NOT NULL,
        Role VARCHAR(50) NOT NULL
    );
END;
GO

IF OBJECT_ID('dbo.AccessLogs', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.AccessLogs (
        LogID INT IDENTITY(1,1) PRIMARY KEY,
        PersonID INT,
        LabName VARCHAR(50),
        AccessTime DATETIME2,
        AccessStatus VARCHAR(20),
        FOREIGN KEY (PersonID)
            REFERENCES dbo.Persons(PersonID)
    );
END;
GO

IF OBJECT_ID('dbo.Evidence', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.Evidence (
        EvidenceID INT IDENTITY(1,1) PRIMARY KEY,
        LogID INT,
        EvidenceType VARCHAR(100),
        Description VARCHAR(255),
        FOREIGN KEY (LogID)
            REFERENCES dbo.AccessLogs(LogID)
    );
END;
GO

IF OBJECT_ID('dbo.Witnesses', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.Witnesses (
        WitnessID INT IDENTITY(1,1) PRIMARY KEY,
        LogID INT,
        WitnessName VARCHAR(100),
        Statement VARCHAR(255),
        FOREIGN KEY (LogID)
            REFERENCES dbo.AccessLogs(LogID)
    );
END;
GO

