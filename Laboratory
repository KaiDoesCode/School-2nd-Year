-- ============================================
-- MISSION 1: ACCESS EVENTS
-- EXPECTED: 5 ROWS
-- ============================================

SELECT
    LogID,
    PersonID,
    EventTime,
    EventType
FROM AccessLogs
WHERE Location = 'Laboratory 3B'
  AND EventTime BETWEEN '21:10:00' AND '21:25:00'
ORDER BY EventTime ASC;

-- ============================================
-- MISSION 2: EVIDENCE REPORT
-- EXPECTED: 6 ROWS
-- ============================================

SELECT
    e.EvidenceID,
    e.EvidenceTime,
    e.EvidenceType,
    COALESCE(p.FullName, 'Unidentified') AS FullName,
    e.Description
FROM Evidence e
LEFT JOIN Persons p
    ON e.PersonID = p.PersonID
WHERE e.EvidenceTime BETWEEN '21:17:00' AND '21:26:00'
ORDER BY e.EvidenceTime ASC;

-- ============================================
-- MISSION 3: WITNESS STATEMENTS
-- EXPECTED: 4 ROWS
-- ============================================

SELECT
    ws.StatementID,
    p.FullName AS WitnessName,
    ws.MentionedPersonID,
    ws.StatementTime,
    ws.StatementText
FROM WitnessStatements ws
JOIN Persons p
    ON ws.WitnessID = p.PersonID
ORDER BY ws.StatementTime ASC;

-- ============================================
-- MISSION 4: ACCESS AND EVIDENCE TIMELINE
-- EXPECTED: 5 ROWS
-- ============================================

SELECT
    p.FullName,
    a.EventTime,
    a.EventType,
    e.EvidenceTime,
    e.EvidenceType,
    e.Description
FROM AccessLogs a
JOIN Persons p
    ON a.PersonID = p.PersonID
JOIN Evidence e
    ON a.PersonID = e.PersonID
WHERE a.Location = 'Laboratory 3B'
  AND a.EventTime BETWEEN '21:10:00' AND '21:25:00'
  AND e.EvidenceTime BETWEEN '21:17:00' AND '21:26:00'
ORDER BY a.EventTime ASC;

-- ============================================
-- MISSION 5: CCTV DETECTION SUMMARY
-- EXPECTED: 4 ROWS
-- ============================================

SELECT
    p.PersonID,
    p.FullName,
    COUNT(e.EvidenceID) AS NumberOfCCTVDetections
FROM Persons p
JOIN Evidence e
    ON p.PersonID = e.PersonID
WHERE e.EvidenceType = 'CCTV Detection'
  AND e.EvidenceTime BETWEEN '21:17:00' AND '21:26:00'
GROUP BY
    p.PersonID,
    p.FullName
ORDER BY p.PersonID ASC;
