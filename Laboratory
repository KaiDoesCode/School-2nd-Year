-- 1. CREATE DATABASE
IF DB_ID('LaboratoryDB') IS NULL
    CREATE DATABASE LaboratoryDB;
GO

USE LaboratoryDB;
GO

-- 2. RESET TABLES
-- WARNING: This deletes existing data in these four tables.
DROP TABLE IF EXISTS WitnessStatements;
DROP TABLE IF EXISTS Evidence;
DROP TABLE IF EXISTS AccessLogs;
DROP TABLE IF EXISTS Persons;
GO

-- 3. CREATE PERSONS TABLE
CREATE TABLE Persons (
    PersonID INT PRIMARY KEY,
    FullName VARCHAR(100),
    RoleName VARCHAR(100)
);

-- 4. CREATE ACCESS LOGS TABLE
CREATE TABLE AccessLogs (
    LogID INT PRIMARY KEY,
    PersonID INT,
    EventTime TIME,
    Location VARCHAR(100),
    EventType VARCHAR(50),
    FOREIGN KEY (PersonID) REFERENCES Persons(PersonID)
);

-- 5. CREATE EVIDENCE TABLE
CREATE TABLE Evidence (
    EvidenceID INT PRIMARY KEY,
    PersonID INT NULL,
    EvidenceTime TIME,
    EvidenceType VARCHAR(100),
    Description VARCHAR(255),
    FOREIGN KEY (PersonID) REFERENCES Persons(PersonID)
);

-- 6. CREATE WITNESS STATEMENTS TABLE
CREATE TABLE WitnessStatements (
    StatementID INT PRIMARY KEY,
    WitnessID INT,
    MentionedPersonID INT,
    StatementTime TIME,
    StatementText VARCHAR(500),
    FOREIGN KEY (WitnessID) REFERENCES Persons(PersonID),
    FOREIGN KEY (MentionedPersonID) REFERENCES Persons(PersonID)
);
GO

